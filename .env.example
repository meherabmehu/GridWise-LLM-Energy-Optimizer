# GridWise service configuration.
# Copy to .env and fill in your own values. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Language model used for operator-note interpretation (REQUIRED)
# ---------------------------------------------------------------------------
# One of: groq | openai | gemini | openai_compatible
LLM_PROVIDER=groq

# API key for the selected provider. LLM_API_KEY always works; the provider
# specific variable name (GROQ_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY) is also
# accepted.
LLM_API_KEY=

# Optional overrides. Leave blank to use the provider defaults:
#   groq     https://api.groq.com/openai/v1            openai/gpt-oss-20b
#   openai   https://api.openai.com/v1                 gpt-4o-mini
#   gemini   https://generativelanguage.googleapis.com/v1beta/openai
#                                                      gemini-2.0-flash
LLM_MODEL=
LLM_BASE_URL=

# Interpreter tuning (seconds, unless noted).
LLM_TIMEOUT_SECONDS=12
LLM_MAX_ATTEMPTS=3
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0

# Reasoning budget for reasoning-capable models (groq defaults to "low"):
# low | medium | high. Leave empty for providers that do not support it.
LLM_REASONING_EFFORT=
LLM_CACHE_SIZE=512
LLM_CACHE_TTL_SECONDS=900

# Set to false to skip the language model entirely (offline diagnostics only -
# the deterministic fallback interpreter is then the only path).
LLM_ENABLED=true

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
